generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  logoUrl     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       User[]
  teams       Team[]
  projects    Project[]
  channels    Channel[]
  conversations Conversation[]
  files       FileAttachment[]
  auditLogs   AuditLog[]
  savedReports SavedReport[]
  feedbacks   Feedback[]
  integrations Integration[]
  automationRules AutomationRule[]
  riskObservations RiskObservation[]
  reportSchedules ReportSchedule[]
  aiAuditLogs AiAuditLog[]
  aiSettings  AiSettings?
  apiKeys     ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  subscription Subscription?
  supportTickets CustomerSupportTicket[]
  projectTemplates ProjectTemplate[]
  oauthApps OAuthApp[]
  knowledgePages KnowledgePage[]
  decisions     DecisionRecord[]
  meetings      MeetingRecord[]
  projectUpdates ProjectUpdate[]
  announcements Announcement[]
  pushSubscriptions PushSubscription[]
  workflows Workflow[]
  customWorkItemTypes CustomWorkItemType[]
  customFieldDefinitions CustomFieldDefinition[]
  approvalRequests ApprovalRequest[]
  organizationPolicies OrganizationPolicy[]
  configurationVersions ConfigurationVersion[]
  githubConnections GitHubConnection[]
  aiConversations AIConversation[]
  githubAppConfig GitHubAppConfig?
  googleConnections GoogleConnection[]
  googleAppConfig GoogleAppConfig?
  scheduledMeetings Meeting[]
  githubLinks   WorkItemGitHubLink[]
  resourceAllocations ResourceAllocation[]
  skillCatalog        SkillCatalog[]
  userSkills          UserSkill[]
  rateCards           RateCard[]
  projectPricings     ProjectPricing[]
  projectProposals    ProjectEstimateProposal[]
  estimateScenarios   EstimateScenario[]
  planningAudits      PlanningAudit[]
  authAllowlists      OrganizationAuthAllowlist[]
  accessRequests      AuthAccessRequest[]
  securityEvents      SecurityEvent[]
}


model User {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String            @unique
  passwordHash     String
  fullName         String
  avatarUrl        String?
  jobTitle         String?
  department       String?
  isActive         Boolean           @default(true)
  role             String            @default("TEAM_MEMBER") // OWNER, ADMIN, PROJECT_MANAGER, TEAM_MEMBER, VIEWER
  status           String            @default("OFFLINE") // ONLINE, OFFLINE, AWAY
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamMemberships  TeamMember[]
  projectMemberships ProjectMember[]
  assignedItems    WorkItem[]        @relation("AssignedWorkItems")
  reportedItems    WorkItem[]        @relation("ReportedWorkItems")
  ledTeams         Team[]            @relation("TeamLead")
  ownedProjects    Project[]         @relation("ProjectOwner")
  comments         WorkItemComment[]
  statusChanges    WorkItemStatusHistory[]
  messages         Message[]
  channelMemberships ChannelMember[]
  conversationMemberships ConversationMember[]
  reactions        MessageReaction[]
  notifications    Notification[]
  notificationPreferences NotificationPreference?
  auditLogs        AuditLog[]
  uploadedFiles    FileAttachment[]
  savedReports     SavedReport[]
  feedbacks        Feedback[]
  automationRules  AutomationRule[]
  aiAuditLogs      AiAuditLog[]
  apiKeys          ApiKey[]
  sessions         UserSession[]
  supportTickets   CustomerSupportTicket[]
  oauthApps        OAuthApp[]
  knowledgePages   KnowledgePage[]
  knowledgeVersions KnowledgePageVersion[]
  knowledgeComments KnowledgePageComment[]
  decisions        DecisionRecord[]
  meetings         MeetingRecord[]
  projectUpdates   ProjectUpdate[]
  announcements    Announcement[]
  pushSubscriptions PushSubscription[]
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  approvedRequests ApprovalRequest[] @relation("ApprovedRequests")
  configurationChanges ConfigurationVersion[]
  githubConnections GitHubConnection[]
  aiConversations AIConversation[]
  googleConnections GoogleConnection[]
  createdMeetings  Meeting[]
  ownedMilestones       Milestone[]
  resourceAllocations   ResourceAllocation[]
  skills                UserSkill[]
  proposalsCreated      ProjectEstimateProposal[]
  estimatesLogged       WorkItemEstimateHistory[]
  authAllowlists        OrganizationAuthAllowlist[]


  @@index([organizationId])
  @@index([email])
}

model Team {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  teamLeadId       String?
  teamLead         User?         @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  capacityHours    Int           @default(160)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  members          TeamMember[]
  workItems        WorkItem[]
  sprints          Sprint[]
  channels         Channel[]
  knowledgePages   KnowledgePage[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
}

model Project {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String          // e.g. PROJ, INT, CLI
  name           String
  description    String?
  ownerId        String
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  status         String          @default("ACTIVE") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, ARCHIVED
  health         String          @default("HEALTHY") // HEALTHY, AT_RISK, CRITICAL
  startDate      DateTime?
  targetDate     DateTime?
  workflowId     String?
  workflow       Workflow?       @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  members        ProjectMember[]
  workItems      WorkItem[]
  sprints        Sprint[]
  channels       Channel[]
  files          FileAttachment[]
  repositories   Repository[]
  riskObservations RiskObservation[]
  knowledgePages KnowledgePage[]
  decisions      DecisionRecord[]
  meetings       MeetingRecord[]
  calendarMeetings Meeting[]
  projectUpdates ProjectUpdate[]
  milestones     Milestone[]
  branchNamingPattern String?     @default("{type}/{humanId}-{slug}")
  plannedStartDate    DateTime?
  plannedEndDate      DateTime?
  actualStartDate     DateTime?
  actualEndDate       DateTime?
  estimationMethod    String?           @default("HOURS") // STORY_POINTS, HOURS, PERSON_DAYS, THREE_POINT, HYBRID
  resourceAllocations ResourceAllocation[]
  pricing             ProjectPricing?
  proposals           ProjectEstimateProposal[]
  scenarios           EstimateScenario[]
  planningAudits      PlanningAudit[]
  automationRules     AutomationRule[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model Sprint {
  id              String     @id @default(uuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name            String
  goal            String?
  startDate       DateTime
  endDate         DateTime
  status          String     @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  createdById     String?
  committedPoints Int        @default(0)
  completedPoints Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workItems       WorkItem[]

  @@index([projectId])
}

model WorkItem {
  id                 String     @id @default(uuid())
  projectId          String
  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  humanId            String     // e.g. PROJ-101, BUG-203
  title              String
  description        String?
  type               String     @default("TASK") // EPIC, FEATURE, USER_STORY, TASK, BUG, SUBTASK
  status             String     @default("TO_DO") // BACKLOG, TO_DO, IN_PROGRESS, CODE_REVIEW, TESTING, BLOCKED, DONE
  priority           String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  severity           String?    // For Bugs: CRITICAL, HIGH, MEDIUM, LOW
  assigneeId         String?
  assignee           User?      @relation("AssignedWorkItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId         String
  reporter           User       @relation("ReportedWorkItems", fields: [reporterId], references: [id], onDelete: Cascade)
  teamId             String?
  team               Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parentId           String?
  parent             WorkItem?  @relation("ParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children           WorkItem[] @relation("ParentChild")
  sprintId           String?
  sprint             Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  storyPoints        Int?       @default(0)
  estimatedHours     Float?     @default(0)
  actualHours        Float?     @default(0)
  optimisticHours    Float?
  mostLikelyHours    Float?
  pessimisticHours   Float?
  personDays         Float?
  remainingHours     Float?
  startDate          DateTime?
  dueDate            DateTime?
  earliestStart      DateTime?
  earliestFinish     DateTime?
  latestStart        DateTime?
  latestFinish       DateTime?
  slackHours         Float?     @default(0)
  isCritical         Boolean    @default(false)
  blockedReason      String?
  environment        String?    // Bug specific
  stepsToReproduce   String?    // Bug specific
  expectedResult     String?    // Bug specific
  actualResult       String?    // Bug specific
  customFieldValues  CustomFieldValue[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  comments           WorkItemComment[]
  statusHistory      WorkItemStatusHistory[]
  tags               WorkItemTag[]
  blockingItems      WorkItemDependency[] @relation("BlockingWorkItem")
  blockedByItems     WorkItemDependency[] @relation("BlockedWorkItem")
  attachments        FileAttachment[]
  messages           Message[]
  pullRequests       PullRequest[]
  meetings           Meeting[]
  githubLinks        WorkItemGitHubLink[]
  estimateHistory    WorkItemEstimateHistory[]

  @@unique([projectId, humanId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([sprintId])
}

model WorkItemStatusHistory {
  id           String   @id @default(uuid())
  workItemId   String
  workItem     WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  oldStatus    String
  newStatus    String
  changedById  String
  changedBy    User     @relation(fields: [changedById], references: [id], onDelete: Cascade)
  changedAt    DateTime @default(now())

  @@index([workItemId])
  @@index([changedAt])
}

model WorkItemDependency {
  id                 String   @id @default(uuid())
  blockingWorkItemId String
  blockingItem       WorkItem @relation("BlockingWorkItem", fields: [blockingWorkItemId], references: [id], onDelete: Cascade)
  blockedWorkItemId  String
  blockedItem        WorkItem @relation("BlockedWorkItem", fields: [blockedWorkItemId], references: [id], onDelete: Cascade)
  type               String   @default("FINISH_TO_START") // FINISH_TO_START, START_TO_START, FINISH_TO_FINISH, START_TO_FINISH
  lagHours           Float    @default(0)
  createdAt          DateTime @default(now())

  @@unique([blockingWorkItemId, blockedWorkItemId])
}

model WorkItemTag {
  id         String   @id @default(uuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  name       String
  color      String   @default("#6366f1")

  @@unique([workItemId, name])
}

model WorkItemComment {
  id         String   @id @default(uuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workItemId])
}

model Channel {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  type           String        @default("PUBLIC") // PUBLIC, PRIVATE, PROJECT, TEAM
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members        ChannelMember[]
  messages       Message[]

  @@unique([organizationId, name])
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // OWNER, MODERATOR, MEMBER
  joinedAt  DateTime @default(now())

  @@unique([channelId, userId])
}

model Conversation {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String               @default("DIRECT") // DIRECT, GROUP
  name           String?              // Group conversation name
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  members        ConversationMember[]
  messages       Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id              String          @id @default(uuid())
  channelId       String?
  channel         Channel?        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content         String
  messageType     String          @default("TEXT") // TEXT, FILE, IMAGE, SYSTEM, WORK_ITEM_REFERENCE
  workItemId      String?
  workItem        WorkItem?       @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  parentMessageId String?
  parentMessage   Message?        @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies         Message[]       @relation("MessageReplies")
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  reactions       MessageReaction[]
  attachments     FileAttachment[]

  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model UserReadState {
  id                String    @id @default(uuid())
  userId            String
  channelId         String?
  conversationId    String?
  lastReadMessageId String?
  lastReadAt        DateTime  @default(now())

  @@unique([userId, channelId])
  @@unique([userId, conversationId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // ASSIGNMENT, MENTION, COMMENT, STATUS_CHANGE, OVERDUE, SPRINT_ENDING
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssignments      Boolean  @default(true)
  mentions             Boolean  @default(true)
  comments             Boolean  @default(true)
  statusChanges        Boolean  @default(true)
  sprintNotifications  Boolean  @default(true)
  projectNotifications Boolean  @default(true)
  chatNotifications    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId])
}

model FileAttachment {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItemId       String?
  workItem         WorkItem?    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  messageId        String?
  message          Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename         String
  filePath         String
  fileType         String
  fileSize         Int
  uploadedById     String
  uploadedBy       User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  driveFileId      String?
  storageProvider  String       @default("LOCAL") // LOCAL | GOOGLE_DRIVE
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt @default(now())

  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action         String
  entityType     String
  entityId       String
  details        String?      // JSON stringified details
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model SavedReport {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name           String
  description    String?
  filters        String       // JSON stringified filters
  metrics        String       // JSON stringified metric selections
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  schedules      ReportSchedule[]

  @@index([organizationId])
}

model Feedback {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String       // BUG | UX_ISSUE | FEATURE_REQUEST | GENERAL
  pageUrl        String?
  description    String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       // GITHUB | GITLAB | BITBUCKET | AZURE_DEVOPS
  name           String
  accountName    String?
  accessToken    String?      // Encrypted token
  webhookSecret  String?
  status         String       @default("CONNECTED") // CONNECTED | DISCONNECTED | ERROR
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  repositories   Repository[]
  eventLogs      IntegrationEventLog[]

  @@index([organizationId])
}

model Repository {
  id             String       @id @default(uuid())
  integrationId  String
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name           String
  fullName       String
  url            String
  defaultBranch  String       @default("main")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  pullRequests   PullRequest[]

  @@index([integrationId])
}

model PullRequest {
  id             String       @id @default(uuid())
  repositoryId   String
  repository     Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  workItemId     String?
  workItem       WorkItem?    @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  number         Int
  title          String
  author         String
  status         String       // OPEN | CLOSED | MERGED
  reviewStatus   String?      // APPROVED | CHANGES_REQUESTED | PENDING
  headBranch     String
  baseBranch     String
  url            String
  mergedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([repositoryId])
  @@index([workItemId])
}

model IntegrationEventLog {
  id             String       @id @default(uuid())
  integrationId  String
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider       String
  eventType      String
  payload        String       // JSON stringified payload
  status         String       // SUCCESS | FAILED
  error          String?
  createdAt      DateTime     @default(now())

  @@index([integrationId])
}

model AutomationRule {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name           String
  description    String?
  trigger        String          // normalized trigger key (e.g., GITHUB_PR_OPENED, WORK_ITEM_STATUS_CHANGED, etc.)
  conditions     String          // JSON stringified safe conditions AST
  actions        String          // JSON stringified safe actions list
  isEnabled      Boolean         @default(true)
  executionCount Int             @default(0)
  failureCount   Int             @default(0)
  lastExecutedAt DateTime?
  throttleMinutes Int            @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  logs           AutomationLog[]

  @@index([organizationId])
  @@index([projectId])
}

model AutomationLog {
  id                String         @id @default(uuid())
  automationRuleId  String
  automationRule    AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
  organizationId    String?
  projectId         String?
  eventId           String?        // Idempotency tracking / webhook delivery ID / correlation ID
  source            String?        // WORK_ITEM | GITHUB_WEBHOOK | SPRINT | CAPACITY | CALENDAR
  actorId           String?
  triggerEvent      String
  matchedConditions Boolean        @default(true)
  actionsExecuted   String         // JSON stringified actions details
  status            String         // SUCCESS | FAILED | THROTTLED | SKIPPED_LOOP | SKIPPED_CONDITION
  errorCode         String?
  error             String?
  durationMs        Int            @default(0)
  startedAt         DateTime       @default(now())
  createdAt         DateTime       @default(now())

  @@index([automationRuleId])
  @@index([eventId])
  @@index([organizationId])
}

model RiskObservation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  severity       String       // LOW | MEDIUM | HIGH | CRITICAL
  sourceMetric   String       // OVERDUE | BLOCKED | CYCLE_TIME | CAPACITY | SCOPE_CREEP
  title          String
  reason         String
  status         String       @default("ACTIVE") // ACTIVE | RESOLVED
  detectedAt     DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([organizationId])
}

model ReportSchedule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedReportId  String
  savedReport    SavedReport  @relation(fields: [savedReportId], references: [id], onDelete: Cascade)
  frequency      String       // DAILY | WEEKLY | MONTHLY
  recipients     String       // JSON stringified recipient user IDs
  isActive       Boolean      @default(true)
  lastSentAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model AiAuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt         String
  toolInvoked    String?
  parameters     String?      // JSON stringified params
  response       String
