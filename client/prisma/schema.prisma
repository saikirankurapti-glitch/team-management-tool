  role        String   // e.g. Data Engineer, Backend Engineer, QA Engineer, Architect, Project Manager
  seniority   String?  // JUNIOR, MID, SENIOR, LEAD, PRINCIPAL
  costRate    Float    // Sensitive internal cost rate
  billingRate Float    // Commercial billing rate
  rateType    String   @default("HOURLY") // HOURLY, DAILY, MONTHLY
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rateCardId])
}

model ProjectPricing {
  id                      String       @id @default(uuid())
  projectId               String       @unique
  project                 Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pricingModel            String       @default("FIXED_PRICE") // FIXED_PRICE, TIME_AND_MATERIAL, MILESTONE_BASED, RETAINER, HYBRID
  estimatedInternalCost   Float        @default(0)
  contingencyPercentage   Float        @default(10)
  markupPercentage        Float        @default(25)
  discountPercentage      Float        @default(0)
  taxPercentage           Float        @default(18)
  grossPrice              Float        @default(0)
  subtotal                Float        @default(0)
  taxAmount               Float        @default(0)
  finalPrice              Float        @default(0)
  currency                String       @default("INR")
  notes                   String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([organizationId])
  @@index([projectId])
}

model ProjectEstimateProposal {
  id                  String       @id @default(uuid())
  projectId           String
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version             Int          @default(1)
  estimateNumber      String       // e.g. EST-PROJ-V1
  status              String       @default("DRAFT") // DRAFT, INTERNAL_REVIEW, APPROVED, SENT, ACCEPTED, REJECTED, EXPIRED
  createdById         String
  createdBy           User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  validUntil          DateTime?
  currency            String       @default("INR")
  scopeSummary        String?
  assumptions         String?
  exclusions          String?
  confidenceScore     String       @default("MEDIUM") // HIGH, MEDIUM, LOW
  totalHours          Float        @default(0)
  totalCost           Float        @default(0)
  proposedPrice       Float        @default(0)
  targetMarginPercent Float        @default(0)
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([createdById])
}

model EstimateScenario {
  id             String       @id @default(uuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // e.g. "Scenario A: +1 Backend Engineer", "Scenario B: Scope Reduction"
  description    String?
  isApplied      Boolean      @default(false)
  scenarioData   String       // JSON encoded scenario parameters and simulated outputs
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([projectId])
}

model PlanningAudit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  action         String       // RESOURCE_ALLOCATED, RESOURCE_REALLOCATED, RESOURCE_REMOVED, ESTIMATE_CREATED, ESTIMATE_UPDATED, ESTIMATE_APPROVED, RATE_CARD_UPDATED, PRICING_UPDATED, SCENARIO_CREATED, SCENARIO_APPLIED, CAPACITY_OVERRIDE, TIMELINE_CHANGED, MILESTONE_CHANGED
  entityType     String
  entityId       String
  oldValue       String?
  newValue       String?
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model OrganizationAuthAllowlist {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider            String       // GOOGLE, GITHUB
  email               String
  normalizedEmail     String
  externalIdentityId  String?      // Google sub or GitHub user ID (immutable)
  userId              String?      // Link to User model
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  status              String       @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED, PENDING
  displayName         String?
  createdBy           String?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginUserAgent  String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, provider, normalizedEmail])
  @@index([organizationId])
  @@index([userId])
  @@index([provider, externalIdentityId])
  @@index([status])
}

model AuthAccessRequest {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider            String       // GOOGLE, GITHUB
  email               String
  normalizedEmail     String?
  externalIdentityId  String?      // Google sub ID or GitHub user ID (immutable)
  name                String?
  displayName         String?
  givenName           String?
  familyName          String?
  profileImageUrl     String?
  status              String       @default("PENDING") // PENDING, APPROVED, REJECTED
  ip                  String?
  userAgent           String?
  attemptCount        Int          @default(1)
  lastSeenAt          DateTime?
  rejectionReason     String?
  mappedUserId        String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([email])
  @@index([normalizedEmail])
  @@index([provider, externalIdentityId])
}

model SecurityEvent {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType       String       // UNAUTHORIZED_LOGIN_ATTEMPT, UNAUTHORIZED_GITHUB_CONNECTION_ATTEMPT, BLOCKED_SUSPENDED_LOGIN, etc.
  provider        String       // GOOGLE, GITHUB, LOCAL
  email           String?
  ip              String?
  userAgent       String?
  details         String?      // JSON payload
  status          String       @default("BLOCKED") // BLOCKED, RECORDED
  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([eventType])
  @@index([createdAt])
}

